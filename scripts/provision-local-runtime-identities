#!/usr/bin/env bash
set -euo pipefail

readonly LOCAL_DB_URL='postgresql://postgres:postgres@127.0.0.1:54322/postgres'
readonly REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly RUNTIME_BOOTSTRAP_SQL="${REPO_ROOT}/ops/sql/bootstrap-hosted-runtime-identities.sql"

if ! command -v psql >/dev/null 2>&1; then
  echo 'psql is required to provision local SwiftPay runtime identities.' >&2
  exit 127
fi

if [[ ! -f "${RUNTIME_BOOTSTRAP_SQL}" ]]; then
  echo 'shared runtime identity bootstrap is missing.' >&2
  exit 66
fi

# Deliberately fixed to the loopback Supabase database. Production credentials
# and managed URLs are never accepted by this K6 test helper.
psql "${LOCAL_DB_URL}" --set=ON_ERROR_STOP=1 --file="${RUNTIME_BOOTSTRAP_SQL}"

# K6 requires real login connections. Install only the historical synthetic
# loopback credentials after the shared credentialless deployment topology is
# established. These values are test fixtures and are never used remotely.
psql "${LOCAL_DB_URL}" --set=ON_ERROR_STOP=1 <<'SQL'
alter role swiftpay_api_runtime password 'local_api_runtime_only';
alter role swiftpay_worker_runtime password 'local_worker_runtime_only';
SQL
